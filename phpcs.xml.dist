<?xml version="1.0"?>
<ruleset name="symfony-bundle">
    <description>PSR-12 coding standard for this package.</description>

    <arg name="basepath" value="."/>
    <arg name="cache" value="working/phpcs.cache"/>
    <arg name="colors"/>
    <arg value="p"/>

    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12"/>
</ruleset>
